{
  "name": "bof3-status",
  "private": true,
  "description": "Status page and picture renderer for the Breath of Fire III decompilation.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node render/snapshot.ts site",
    "report": "node render/publish.ts",
    "test": "node --test \"test/*.test.ts\"",
    "lint": "tsc -p .",
    "format": "dprint fmt",
    "licenses": "node render/licenses.ts"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "echarts": "6.1.0",
    "license-checker-rseidelsohn": "5.0.1",
    "solid-js": "1.9.18",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
